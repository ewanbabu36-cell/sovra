# =============================================================================
# SOVRA PRODUCTION DOCKERFILE - DECOUPLED API SERVICE
# Multi-stage minimal production image for @sovra/api microservice
# =============================================================================

# --- Stage 1: Build Dependencies ---
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@12.8.1

# Copy workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY services/ ./services/
COPY scripts/ ./scripts/

# Install and build packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @sovra/protocol run build || true
RUN pnpm --filter @sovra/shared run build || true
RUN pnpm --filter @sovra/api run build

# --- Stage 2: Production Minimal Runtime ---
FROM node:22-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0

# Install runtime utilities (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -r -g 10001 sovra && \
    useradd -r -u 10001 -g sovra -m -d /app sovra

# Copy artifacts from builder
COPY --from=builder --chown=sovra:sovra /app/package.json ./package.json
COPY --from=builder --chown=sovra:sovra /app/packages/ ./packages/
COPY --from=builder --chown=sovra:sovra /app/services/ ./services/
COPY --from=builder --chown=sovra:sovra /app/node_modules/ ./node_modules/

USER sovra:sovra

EXPOSE 3001

# Production Docker Healthcheck
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/health/liveness || exit 1

# Graceful termination
STOPSIGNAL SIGTERM

ENTRYPOINT ["node", "services/api/dist/server.js"]
