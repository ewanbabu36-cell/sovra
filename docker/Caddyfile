# ============================================================
#   SOVRA PRODUCTION REVERSE PROXY & AUTOMATIC TLS CONFIGURATION
#   Supports Automatic Let's Encrypt ACME when SOVRA_DOMAIN is set
#   (e.g. sovra.network) and Local Internal TLS when localhost.
# ============================================================

{
  email {$SOVRA_ACME_EMAIL:ops@sovra.network}
  auto_https prefer_wildcard
}

{$SOVRA_DOMAIN:localhost} {
  # Security Headers (OWASP Hardening)
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    X-XSS-Protection "1; mode=block"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
  }

  encode zstd gzip

  # Android Digital Asset Links & Apple App Site Association
  @wellknown {
    path /.well-known/assetlinks.json /.well-known/apple-app-site-association
  }
  handle @wellknown {
    header Content-Type "application/json; charset=utf-8"
    header Access-Control-Allow-Origin "*"
    reverse_proxy sovra-node:3001
  }

  # Realtime Server-Sent Events (SSE) & CometBFT WebSocket bypass buffering
  @sse {
    path /api/realtime/stream* /api/chat/events* /api/blockchain/stream* /websocket*
  }
  handle @sse {
    reverse_proxy sovra-node:3001 {
      flush_interval -1
      header_up Connection "keep-alive"
      header_up Cache-Control "no-cache"
    }
  }

  # Media, HLS Adaptive Streaming & Byte-Range Support
  @media {
    path /api/feed/video/* /api/feed/image/* /api/videos/hls/* /api/video/hls/* /api/videos/storyboard/* /api/video/storyboard/* /api/media/*
  }
  handle @media {
    reverse_proxy sovra-node:3001 {
      header_down Accept-Ranges "bytes"
    }
  }

  # All general API & UI requests
  handle {
    reverse_proxy sovra-node:3001 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
}
