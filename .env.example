# ============================================================
#   SOVRA PROTOCOL - PRODUCTION ENVIRONMENT CONFIGURATION
#   Copy this file to .env.production and configure real values.
#   NEVER commit actual production secrets to source control.
# ============================================================

# Environment Mode: 'production' | 'staging' | 'development' | 'test'
NODE_ENV=production

# Server Ports
PORT=3001
SOVRA_HTTP_PORT=3001
SOVRA_P2P_PORT=4001

# Persistent Storage Path (SQLite database, media, keys)
# In Docker/Kubernetes, mount this to a persistent volume (PVC)
SOVRA_STORAGE_DIR=/app/.sovra-storage-prod

# ============================================================
#   SECURITY & SECRETS (REQUIRED IN PRODUCTION)
# ============================================================

# Master Administrative Secret Key (MUST be at least 32 characters)
# Generate using: openssl rand -hex 32
ADMIN_SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars!

# WebRTC STUN/TURN Relay Server Configuration
# STUN provides NAT traversal; TURN relays media across symmetric NATs/firewalls
SOVRA_TURN_SERVERS=stun:stun.l.google.com:19302,turn:turn.sovra.network:3478?transport=udp
# Static secret used to generate ephemeral HMAC-SHA1 credentials for WebRTC callers
# Must match the static-auth-secret in your coturn turnserver.conf
SOVRA_TURN_SECRET=replace_with_turn_server_hmac_secret_min_32_chars!
SOVRA_TURN_TTL=86400

# CORS & Origin Security
# Comma-separated list of trusted production origins (NO wildcard '*' allowed in prod)
SOVRA_ALLOWED_ORIGINS=https://sovra.network,https://app.sovra.network

# Rate Limiting
# In production, default token bucket enforces 200 req / 40 refill rate per IP
SOVRA_RATE_LIMIT_CAPACITY=200
SOVRA_RATE_LIMIT_REFILL=40

# Logging & Observability
SOVRA_LOG_LEVEL=info
SOVRA_LOG_FORMAT=json

# SQLite Production Tuning Pragmas
SOVRA_SQLITE_BUSY_TIMEOUT=5000
SOVRA_SQLITE_CACHE_SIZE=-64000
SOVRA_SQLITE_MMAP_SIZE=268435456
