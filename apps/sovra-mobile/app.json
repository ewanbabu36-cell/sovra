{
  "expo": {
    "name": "Sovra",
    "slug": "sovra-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "network.sovra.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Sovra needs camera access to record reels, capture stories, and scan peer QR codes.",
        "NSMicrophoneUsageDescription": "Sovra needs microphone access to record voice notes and audio for reels.",
        "NSFaceIDUsageDescription": "Sovra uses FaceID to authenticate passkeys and secure local private keys."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "package": "network.sovra.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "sovra-planetary-decentralized-network"
      }
    }
  }
}
