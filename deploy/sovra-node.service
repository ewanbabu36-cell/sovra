[Unit]
Description=Sovra Sovereign Node & P2P Mesh Engine
Documentation=https://github.com/sovra/sovra
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sovra
Group=sovra
WorkingDirectory=/opt/sovra
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s

# Production Resource Constraints & Open File Descriptors
LimitNOFILE=65536
LimitNPROC=32768
MemoryMax=4G
MemoryHigh=3.5G
CPUQuota=400%

# Linux Kernel Sandboxing & Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

# Environment Variables
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=SOVRA_STORAGE_DIR=/opt/sovra/.sovra-storage-prod
Environment=SOVRA_P2P_PORT=4001
Environment=SOVRA_HTTP_PORT=3001
Environment=SOVRA_HTTPS_PORT=3443

# Standard Logging to Systemd Journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sovra-node

[Install]
WantedBy=multi-user.target
