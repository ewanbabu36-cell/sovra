{
  "name": "sovra-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sovra — Decentralized Social Platform & Operations Console",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types scripts/dev-server.ts",
    "node:volunteer": "node --experimental-strip-types scripts/volunteer-node.ts",
    "node:seed": "node --experimental-strip-types scripts/bootstrap-node.ts",
    "build": "node --experimental-strip-types scripts/build-client-bundle.ts",
    "build:client": "node --experimental-strip-types scripts/build-client-bundle.ts",
    "build:mobile": "node --experimental-strip-types apps/sovra-mobile/build-mobile-bundle.ts",
    "test:prod-build": "node --check scripts/dev-server.ts && node --check scripts/database-engine.ts && node --experimental-strip-types scripts/build-client-bundle.ts",
    "dev": "node --experimental-strip-types scripts/dev-server.ts",
    "tunnel:ngrok": "node scripts/run-ngrok.js",
    "tunnel:cf": "node scripts/run-cloudflare-tunnel.js",
    "test": "vitest run",
    "test:fast": "vitest run --fileParallelism false tests/unit/client-script-integrity.test.ts tests/e2e/holographic-navigation.test.ts tests/e2e/pwa-manifest.test.ts tests/e2e/ftux-activation.test.ts tests/e2e/webrtc-stories-pwa.test.ts",
    "validate:integrity": "vitest run --fileParallelism false --teardownTimeout 15000 tests/unit/client-script-integrity.test.ts tests/e2e/pwa-manifest.test.ts tests/e2e/ftux-activation.test.ts tests/e2e/webrtc-stories-pwa.test.ts",
    "test:watch": "vitest",
    "audit:prelaunch": "vitest run tests/audit/pre_launch_master_control_audit.test.ts tests/audit/pre_launch_adversarial_audit.test.ts tests/audit/world_standard_flagship_audit.test.ts",
    "test:architecture": "vitest run tests/security/dependency-boundaries.test.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "react": "^19.3.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "tinypool": ">=2.1.2",
    "vite": ">=7.3.7"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1"
  }
}
