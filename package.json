{
  "name": "sovra-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sovra — Decentralized Social Platform & Operations Console",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:client": "node --experimental-strip-types scripts/build-client-bundle.ts",
    "dev": "node --experimental-strip-types scripts/dev-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run tests/security/dependency-boundaries.test.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "react": "^19.3.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
